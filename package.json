{
  "name": "dsh-health-reminder",
  "version": "0.5.2",
  "description": "健康提醒插件：按你自定义的作息定时提醒喝水、起身、护眼和拉伸，带每日/每周统计，以及多套可随时切换的提醒方案。",
  "icon": "icon.svg",
  "type": "module",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorawithcat/dsh-health-reminder.git"
  },
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2 <0.3.0-0 || >=0.3.0-rc.1 <0.4.0-0 || >=0.4.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-commands"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0 || >=0.3.0-rc.1 <0.4.0-0 || >=0.4.0-rc.1"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "license": "BSD-3-Clause"
}
